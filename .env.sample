# Home Assistant — obbligatori
HA_URL=http://homeassistant.local:8123
HA_TOKEN=

# Porte esposte sull'host (dentro il container restano 47821 e 47822)
MCP_PORT=47821
UI_PORT=47822

# Autenticazione del server MCP.
# MCP_SECRET protegge l'endpoint MCP; senza, il server rifiuta di partire a meno
# di non impostare esplicitamente MCP_ALLOW_NO_AUTH=true — che ha senso solo su
# una rete fidata.
MCP_SECRET=
MCP_ALLOW_NO_AUTH=

# Se vuoto, la dashboard web usa MCP_SECRET.
UI_SECRET=

# Opzionali
HA_DEFAULT_LANGUAGE=
HA_ALEXA_KEYWORDS=
HA_REMOTE_PREFIXES=
