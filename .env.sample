# Home Assistant — required
HA_URL=http://homeassistant.local:8123
HA_TOKEN=

# Ports exposed on the host (inside the container they stay 47821 and 47822)
MCP_PORT=47821
UI_PORT=47822

# MCP server authentication.
# MCP_SECRET protects the MCP endpoint; without it, the server refuses to
# start unless you explicitly set MCP_ALLOW_NO_AUTH=true — which makes sense
# only on a trusted network.
MCP_SECRET=
MCP_ALLOW_NO_AUTH=

# DNS-rebinding defense: the MCP endpoint rejects any request whose Origin or
# Host header does not resolve to "localhost" or one of the hosts/IPs listed
# here (comma-separated, no scheme or port), e.g.
# "192.168.1.50,homeassistant.local". Applied unconditionally, regardless of
# MCP_SECRET. A request with no Origin header (a non-browser MCP client) is
# never affected by this check.
MCP_ALLOWED_HOSTS=

# Status dashboard password (Basic Auth) — its own secret, distinct from
# MCP_SECRET: the dashboard sends it as HTTP Basic in the clear (base64, not
# encrypted), so reusing MCP_SECRET would expose the MCP token to anyone
# watching the network. openssl rand -base64 32, a value different from
# MCP_SECRET. If left empty, the dashboard refuses to start unless you
# explicitly set UI_ALLOW_NO_AUTH=true — a decision separate from
# MCP_ALLOW_NO_AUTH, which concerns only the MCP endpoint, not the dashboard.
UI_SECRET=
UI_ALLOW_NO_AUTH=

# Set only when the dashboard is reached exclusively through the Home
# Assistant Supervisor's Ingress proxy (the app's own run.sh sets this) —
# Ingress requests carry no Authorization header, and HA has already
# authenticated the user before the request reaches this server. Do NOT set
# this in a plain container deployment unless something equivalent to
# Ingress sits in front of it and nothing else can reach UI_PORT.
HA_INGRESS_MODE=

# Optional
HA_DEFAULT_LANGUAGE=
HA_ALEXA_KEYWORDS=
HA_REMOTE_PREFIXES=

# Registers create_user/update_user/delete_user (Home Assistant login
# accounts, not entities) only when set to true. Off by default: almost
# nobody needs a language model to be able to create accounts. Every other
# destructive tool (delete_*, restart_homeassistant, ...) stays active by
# default. list_disabled_tools() is always registered and reports which
# groups are disabled and why.
MCP_ENABLE_USER_MANAGEMENT=

# lock_control/alarm_control: active by default (unlike user management,
# controlling locks and the alarm is a normal reason to run this server).
# Set to false to remove them from the client's menu - a defense against a
# prompt injection that names the tool directly, not against call_service,
# which reaches the same service calls directly and is not covered by any
# gate.
MCP_ENABLE_PHYSICAL_SECURITY=

# call_addon_api: off by default. A generic proxy into an installed add-on's
# HTTP API - few installations need it, and unlike physical_security,
# disabling it here really does remove the capability: neither call_service
# nor fire_event can reach the Supervisor's proxy endpoint.
MCP_ENABLE_ADDON_API=
